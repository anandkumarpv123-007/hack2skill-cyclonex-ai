# ==============================================================================
# CYCLONEX Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Server & Runtime
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Data Source Mode: 'simulated' (benchmark datasets) or 'live' (external APIs)
DATA_SOURCE_MODE=simulated
DEFAULT_BENCHMARK_SCENARIO=cyclone_michaung_2023

# External Meteorological APIs (Milestone 3)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Google Cloud Platform & Vertex AI (Milestone 4)
# When DATA_SOURCE_MODE=simulated, mock fallbacks are used if credentials are absent.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-3.7-flash

# Google Earth Engine (Milestone 4)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# Firebase / Firestore (Optional Scenario Persistence)
FIRESTORE_PROJECT_ID=
